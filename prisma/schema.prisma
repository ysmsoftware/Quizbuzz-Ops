generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum PlatformAdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  // Period lapsed (currentPeriodEnd passed) without a renewal payment.
  // Distinct from CANCELLED (an explicit admin/org action) — set only by
  // the nightly subscription-reconciliation job. See subscription-reconciliation.job.ts.
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum AuditTargetType {
  ORGANIZATION
  PLAN
  SUBSCRIPTION
  OVERRIDE
  PAYMENT
  BOOKING
  PRICING_CONFIG
  FEATURE_FLAG
  PLATFORM_ADMIN
  AMBASSADOR_TYPE
}

enum OpsPaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  QUOTED
  PAID
  PROVISIONED
  COMPLETED
  CANCELLED
}

enum FeatureFlagSeverity {
  STANDARD // routine toggle, no confirmation dialog
  WARNING  // confirmation dialog, amber "emergency" styling — e.g. new_registrations_paused
  CRITICAL // confirmation dialog, red styling, strongest copy — e.g. maintenance_mode
}

// MODELS

model PlatformAdmin {
  id            String            @id
  email         String            @unique
  passwordHash  String
  firstName     String
  lastName      String?
  role          PlatformAdminRole @default(SUPPORT)
  isActive      Boolean           @default(true)
  otpCode       String?
  otpExpiresAt  DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  refreshTokens PlatformAdminRefreshToken[]
  auditEntries  PlatformAuditLog[]
  orgNotes      OrganizationNote[]
  pricingConfigUpdates PricingConfig[]
  contestBookings      ContestBooking[]
  featureFlagUpdates   FeatureFlag[]
  ambassadorTypesCreated       AmbassadorType[]
  ambassadorTypeAccessUpdates  OrganizationAmbassadorTypeAccess[]

  @@index([email])
  @@map("platform_admins")
}

model PlatformAdminRefreshToken {
  id          String    @id
  adminId     String
  tokenHash   String    @unique
  deviceInfo  String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  admin       PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("platform_admin_refresh_tokens")
}

model OrganizationNote {
  id             String   @id
  organizationId String
  authorId       String
  body           String
  tags           String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author         PlatformAdmin @relation(fields: [authorId], references: [id])

  @@index([organizationId])
  @@map("organization_notes")
}

model OrganizationSuspension {
  id             String    @id
  organizationId String
  reason         String
  suspendedById  String
  suspendedAt    DateTime  @default(now())
  liftedById     String?
  liftedAt       DateTime?
  liftReason     String?

  @@index([organizationId])
  @@map("organization_suspensions")
}

model PlatformAuditLog {
  id          String          @id
  requestId   String?
  actorId     String?
  actorLabel  String
  action      String
  targetType  AuditTargetType
  targetId    String
  targetLabel String
  metadata    Json?
  createdAt   DateTime        @default(now())

  actor PlatformAdmin? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([requestId])
  @@map("platform_audit_logs")
}

model SubscriptionPlan {
  id            String       @id
  name          String
  slug          String       @unique
  description   String?
  currency      String       @default("INR")

  // Which billing cycles this plan can be purchased under, and the price for
  // each. Independent per plan — a tier can be monthly-only, annual-only with
  // its own fixed rate, or both. Annual is never auto-derived from monthly;
  // an admin sets each enabled cycle's price explicitly.
  allowsMonthly Boolean      @default(true)
  allowsAnnual  Boolean      @default(false)
  monthlyPrice  Decimal?     @db.Decimal(10, 2)
  annualPrice   Decimal?     @db.Decimal(10, 2)

  isActive      Boolean      @default(true)

  maxContestsPerCycle       Int?
  maxParticipantsPerContest Int?
  maxQuestionsPerContest    Int?
  maxOrgMembers             Int?

  featureProctoring          Boolean @default(false)
  featureCertBranding        Boolean @default(false)
  featurePrioritySupport     Boolean @default(false)
  featureAnalyticsExport     Boolean @default(false)
  featureCustomDomain        Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions OrganizationSubscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

model OrganizationSubscription {
  id                 String             @id
  organizationId     String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  // Cycle actually purchased for the current period — independent of
  // whatever SubscriptionPlan's own allowsMonthly/allowsAnnual say today,
  // since that can change after this subscription was created.
  billingCycle       BillingCycle       @default(MONTHLY)
  periodMonths       Int                @default(1)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  // Set by the nightly reconciliation job when SUBSCRIPTION_RENEWAL_REMINDER
  // is sent (currentPeriodEnd within 7 days). Counts as "already sent for
  // the CURRENT period" only when >= currentPeriodStart, so a renewed
  // subscription becomes eligible for a fresh reminder automatically —
  // no explicit reset needed on assignPlan/changePlan.
  renewalReminderSentAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  plan      SubscriptionPlan       @relation(fields: [planId], references: [id])
  overrides SubscriptionOverride[]
  changes   SubscriptionChangeLog[]

  @@index([planId])
  @@index([status, currentPeriodEnd])
  @@map("organization_subscriptions")
}

// ADDITIVE: `value` is a delta stacked on top of whatever the effective limit
// already was (base plan value + any earlier ADDITIVE overrides, applied in
// createdAt order) — this is the "existing plan + 1" behavior.
// ABSOLUTE: `value` replaces the limit outright, same as the original
// (pre-stacking) override behavior. Kept for admins who genuinely want to
// set an exact number rather than add to what's there.
//
// New column defaults to ABSOLUTE so every override that already existed
// before this field was added keeps behaving exactly as it did (it was
// always a straight replacement) — only overrides created going forward
// default to ADDITIVE at the application layer (see SubscriptionsService.addOverride).
enum OverrideMode {
  ADDITIVE
  ABSOLUTE
}

model SubscriptionOverride {
  id             String       @id
  subscriptionId String
  field          String
  value          Int?
  mode           OverrideMode @default(ABSOLUTE)
  reason         String
  createdById    String
  expiresAt      DateTime?
  removedAt      DateTime?
  removedById    String?
  removedReason  String?
  createdAt      DateTime     @default(now())

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, removedAt])
  @@index([expiresAt])
  @@map("subscription_overrides")
}

model FeatureFlag {
  id                  String               @id
  key                 String               @unique // stable slug, e.g. "maintenance_mode"
  label               String
  description         String
  isEnabled           Boolean              @default(false) // global default value
  severity            FeatureFlagSeverity  @default(STANDARD)
  // Whether this flag can carry per-organization overrides at all. False for
  // flags that are inherently platform-wide (maintenance_mode — "maintenance
  // for one org" isn't a coherent concept) so the ops UI/API can decline to
  // even offer the "manage per-org" affordance rather than silently allowing
  // an override that would never be read.
  supportsOrgOverride Boolean              @default(true)
  // Set when this flag's key is removed from the code registry
  // (server/features/feature-flags/feature-flag-registry.ts) — never
  // hard-deleted, since feature_flag_org_overrides.flagKey has an
  // ON DELETE RESTRICT FK back to this table's `key`, and even a flag with
  // no live overrides should keep its PlatformAuditLog trail addressable.
  // Deprecated flags are excluded from the default admin list view but keep
  // functioning exactly as before for any code path still reading them.
  deprecatedAt        DateTime?
  updatedById         String?
  updatedByName       String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  updatedBy      PlatformAdmin?          @relation(fields: [updatedById], references: [id])
  orgOverrides   FeatureFlagOrgOverride[]

  @@index([key])
  @@map("feature_flags")
}

// Per-organization override of a flag's global value — modeled on
// SubscriptionOverride above: soft-deleted via removedAt/removedById/
// removedReason rather than updated in place, so the full history of who
// granted/revoked an org's access to a feature is preserved in the row
// itself. Scoped directly to organizationId (a plain String, not a
// relation) because org data lives entirely in Quizbuzz-new's own database —
// this repo only ever stores/references organizationId as an opaque string.
model FeatureFlagOrgOverride {
  id             String    @id
  // References FeatureFlag.key, not FeatureFlag.id — readable in queries and
  // consistent with how API paths key off `key` (/feature-flags/[key]/...).
  flagKey        String
  organizationId String
  isEnabled      Boolean
  reason         String
  createdById    String
  createdByName  String
  expiresAt      DateTime?
  removedAt      DateTime?
  removedById    String?
  removedReason  String?
  createdAt      DateTime  @default(now())

  flag FeatureFlag @relation(fields: [flagKey], references: [key])

  @@index([flagKey, organizationId, removedAt])
  @@map("feature_flag_org_overrides")
}

// Ambassador Type catalog — ops-curated, runtime-creatable (unlike FeatureFlag above, which is
// code-registry-first). "Student" / "Faculty" / "General" / a future "Industry" type each carry their
// own applicationFields form schema, so a new type — and what it asks an applicant for — never needs a
// code deploy. See ambassador-incentive-program-plan.md §0.3 for the full design reasoning.
model AmbassadorType {
  id                String    @id
  key               String    @unique // stable slug set at creation, e.g. "student" — immutable, mirrored into the main app
  label             String
  description       String?
  proofFieldLabel   String    @default("Identity / Enrollment Proof")
  // Ordered array of { key, label, type, required, options? } — the extra fields this type's
  // application form asks for beyond the fixed baseline (name/email/phone/proof). See
  // ambassador-types.validator.ts for the exact shape this is validated against.
  applicationFields Json      @default("[]")
  isActive          Boolean   @default(true) // ops can retire a type without deleting history
  createdById       String?
  createdByName     String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy   PlatformAdmin?                     @relation(fields: [createdById], references: [id])
  orgAccess   OrganizationAmbassadorTypeAccess[]

  @@index([key])
  @@map("ambassador_types")
}

// Per-organization enablement of a type — deliberately lighter-weight than FeatureFlagOrgOverride
// (no required reason/expiresAt): this is a lower-stakes "which types can this org's applicants pick
// from" toggle, not a platform kill-switch. Updated in place (not soft-deleted/replaced) since there's
// no override-history requirement here the way there is for flags.
model OrganizationAmbassadorTypeAccess {
  id               String   @id
  organizationId   String   // Quizbuzz-new's Organization.id — opaque string, no FK (cross-database)
  ambassadorTypeId String
  isEnabled        Boolean  @default(false)
  updatedById      String?
  updatedByName    String
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  ambassadorType AmbassadorType @relation(fields: [ambassadorTypeId], references: [id])
  updatedBy      PlatformAdmin? @relation(fields: [updatedById], references: [id])

  @@unique([organizationId, ambassadorTypeId])
  @@map("organization_ambassador_type_access")
}

model SubscriptionChangeLog {
  id             String   @id
  subscriptionId String
  fromPlanId     String?
  toPlanId       String
  changedById    String?
  changedVia     String
  createdAt      DateTime @default(now())

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_change_logs")
}

enum OpsMessageChannel {
  EMAIL
  WHATSAPP
}

enum OpsMessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
}

enum OpsMessageTemplate {
  BILLING_PAYMENT_SUCCESS
  // Itemized, resendable record of a payment — distinct from
  // BILLING_PAYMENT_SUCCESS's short immediate confirmation. Also triggered
  // on-demand by the resend-receipt admin action.
  BILLING_RECEIPT
  BILLING_PAYMENT_FAILED
  // No SUBSCRIPTION_PAST_DUE: this system has no auto-renewal/card-on-file —
  // every purchase is a manual, advance, one-time charge for a fixed period.
  // There is no "we tried to charge you and it failed" state to notify
  // about; SUBSCRIPTION_RENEWAL_REMINDER (before) and SUBSCRIPTION_EXPIRED
  // (after) already cover the period-end lifecycle.
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_EXPIRED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_PLAN_CHANGED
  SUBSCRIPTION_LIMIT_INCREASED
  SUBSCRIPTION_LIMIT_DECREASED
  PAYOUT_ACCOUNT_LINKED
  PAYOUT_ACCOUNT_STATUS_CHANGED
  ORG_SUSPENDED
  ORG_REACTIVATED
  CUSTOM
  // Platform-admin login OTP. Sent directly via getEmailProvider() from
  // platform-auth.service.ts — bypasses OpsMessageLog/the BullMQ queue on
  // purpose (this isn't an organization-scoped message: OpsMessageLog.organizationId
  // is required and a platform admin login has no organization to attach it
  // to, and a login OTP needs to go out synchronously, not queued).
  // Included in this enum purely so it can reuse the shared
  // IMessageProvider/getEmailTemplate rendering pipeline.
  PLATFORM_ADMIN_OTP
}

// Ops -> organization-admin outbound messaging log.
// Distinct from the main app's participant-facing MessageLog — this table
// belongs entirely to the ops dashboard and tracks platform-admin-initiated
// notifications (billing, subscription, payout events).
//
// The channel enum includes WHATSAPP so the schema never needs another
// migration when WhatsApp is switched on — the *code* fully supports it
// today, but the public send API only accepts EMAIL until
// WHATSAPP_MESSAGING_ENABLED is turned on (see server/config/messaging.config.ts).
model OpsMessageLog {
  id             String             @id
  organizationId String
  channel        OpsMessageChannel
  template       OpsMessageTemplate
  recipient      String             // email address or E.164 phone number
  subject        String?            // email subject (unused for WhatsApp)
  params         Json?              // template parameters used to render the message
  metadata       Json?              // raw provider response, for audit/debugging
  status         OpsMessageStatus   @default(QUEUED)
  providerMsgId  String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  failureReason  String?
  retryCount     Int                @default(0)
  attemptCount   Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
  @@index([status, createdAt])
  @@index([template])
  @@map("ops_message_logs")
}

model OpsPayment {
  id                String           @id
  organizationId    String
  purpose           String
  planId            String?
  subscriptionId    String?
  bookingId         String?
  booking           ContestBooking?

  // Cycle + duration this payment is for, and the full price breakdown that
  // produced `amount` — a self-contained receipt, not just a final total.
  billingCycle      BillingCycle?
  periodMonths      Int?
  baseAmount        Decimal?         @db.Decimal(10, 2)
  gatewayFeeAmount  Decimal?         @db.Decimal(10, 2)
  gstAmount         Decimal?         @db.Decimal(10, 2)
  // Unused-time credit from the org's prior active subscription, already
  // subtracted from baseAmount above (baseAmount is post-credit). Kept as
  // its own field so the payment stays a self-contained, itemized receipt.
  creditApplied     Decimal?         @db.Decimal(10, 2)

  amount            Decimal          @db.Decimal(10, 2)
  currency          String           @default("INR")
  status            OpsPaymentStatus @default(CREATED)
  razorpayOrderId   String?          @unique
  razorpayPaymentId String?          @unique
  razorpaySignature String?
  paidAt            DateTime?
  refundedAt        DateTime?
  refundReason      String?
  refundedById      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([organizationId])
  @@index([status, createdAt])
  @@index([planId])
  @@map("ops_payments")
}

model PricingConfig {
  id                                   String   @id @default("pricing_default")
  currency                             String   @default("INR")
  baseBookingFee                       Decimal  @db.Decimal(10, 2)
  perParticipantCost                   Decimal  @db.Decimal(10, 2)
  perQuestionCost                      Decimal  @db.Decimal(10, 2)
  perInstanceHourCost                  Decimal  @db.Decimal(10, 2)
  participantsPerInstance              Int
  elastiCachePerDayCost                Decimal  @db.Decimal(10, 2)
  addOnProctoringEnabled               Boolean  @default(true)
  addOnProctoringFlatCost              Decimal  @db.Decimal(10, 2)
  addOnCertificatesEnabled             Boolean  @default(true)
  addOnCertificatesPerParticipantCost  Decimal  @db.Decimal(10, 2)
  addOnPrioritySupportEnabled          Boolean  @default(true)
  addOnPrioritySupportFlatCost         Decimal  @db.Decimal(10, 2)
  marginMultiplier                     Decimal  @db.Decimal(5, 3)
  updatedById                          String?
  updatedByName                        String
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt

  updatedBy PlatformAdmin? @relation(fields: [updatedById], references: [id])

  @@map("pricing_configs")
}

model ContestBooking {
  id                    String        @id
  status                BookingStatus @default(QUOTED)

  organizationId        String?
  organizationName      String?
  organizationEmail     String?

  contestName           String
  durationMinutes       Int
  questionCount         Int
  participantCount      Int

  addOnProctoring       Boolean
  addOnCertificates     Boolean
  addOnPrioritySupport  Boolean

  pricingBreakdown      Json

  desiredStartTime      DateTime?
  quotedAt              DateTime      @default(now())
  paidAt                DateTime?
  provisionedAt         DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  paymentMethod         String?
  paymentReference      String?
  opsPaymentId          String?       @unique

  createdById           String
  createdByName         String

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  createdBy PlatformAdmin @relation(fields: [createdById], references: [id])
  opsPayment OpsPayment?  @relation(fields: [opsPaymentId], references: [id])

  @@index([status])
  @@index([organizationId])
  @@index([quotedAt])
  @@map("contest_bookings")
}
